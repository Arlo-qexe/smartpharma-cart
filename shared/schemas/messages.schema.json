{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SmartPharma Cart - Mensajes del protocolo",
  "description": "Definición formal de cada tipo de mensaje. Debe mantenerse en sincronía con shared/protocol_constants.py y shared/protocol_constants.h. Ver docs/arquitectura_comunicacion.md para el contexto de cada uno.",
  "definitions": {
    "orangepi_a_esp32__activar_dispensador": {
      "type": "object",
      "properties": {
        "accion": { "const": "activar_dispensador" }
      },
      "required": ["accion"],
      "additionalProperties": false
    },
    "esp32_a_orangepi__objeto_en_posicion": {
      "type": "object",
      "properties": {
        "evento": { "const": "objeto_en_posicion" }
      },
      "required": ["evento"],
      "additionalProperties": false
    },
    "orangepi_a_esp32__girar_posicion": {
      "type": "object",
      "properties": {
        "accion": { "const": "girar_posicion" },
        "cara": { "type": "integer", "minimum": 1, "maximum": 5 }
      },
      "required": ["accion", "cara"],
      "additionalProperties": false
    },
    "esp32_a_orangepi__en_posicion": {
      "type": "object",
      "properties": {
        "evento": { "const": "en_posicion" },
        "cara": { "type": "integer", "minimum": 1, "maximum": 5 }
      },
      "required": ["evento", "cara"],
      "additionalProperties": false
    },
    "orangepi_a_esp32__activar_alarma_local": {
      "type": "object",
      "properties": {
        "accion": { "const": "activar_alarma_local" }
      },
      "required": ["accion"],
      "additionalProperties": false
    },
    "orangepi_a_esp32__desactivar_alarma_local": {
      "type": "object",
      "properties": {
        "accion": { "const": "desactivar_alarma_local" }
      },
      "required": ["accion"],
      "additionalProperties": false
    },
    "orangepi_a_esp32__clasificar": {
      "type": "object",
      "properties": {
        "accion": { "const": "clasificar" },
        "destino": { "type": "string" }
      },
      "required": ["accion", "destino"],
      "additionalProperties": false
    },
    "orangepi_a_pc__consulta_decision": {
      "type": "object",
      "description": "Consulta TCP corta de la Orange Pi a la PC (puerto TCP_PUERTO_DECISION_DEFECTO) tras recibir ERROR_REVISION_MANUAL. Ver docs/propuesta_canal_regente.md.",
      "properties": {
        "consulta": { "const": "decision_regente" }
      },
      "required": ["consulta"],
      "additionalProperties": false
    },
    "pc_a_orangepi__respuesta_decision": {
      "description": "Respuesta de la PC a la consulta de decisión del regente.",
      "oneOf": [
        {
          "type": "object",
          "properties": { "estado": { "enum": ["pendiente", "ninguna"] } },
          "required": ["estado"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "estado": { "const": "resuelta" },
            "destino": { "type": "string", "pattern": "^[A-Z0-9_]{1,32}$", "description": "TIPO_X o DESCARTE" }
          },
          "required": ["estado", "destino"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "error": { "const": "consulta_invalida" } },
          "required": ["error"],
          "additionalProperties": false
        }
      ]
    },
    "orangepi_a_pc__consulta_orden_ciclo": {
      "type": "object",
      "description": "Consulta TCP corta de la Orange Pi a la PC (puerto TCP_PUERTO_DECISION_DEFECTO) al arrancar, hasta recibir 'iniciar'. Ver informe 4.7.",
      "properties": {
        "consulta": { "const": "orden_ciclo" }
      },
      "required": ["consulta"],
      "additionalProperties": false
    },
    "pc_a_orangepi__respuesta_orden_ciclo": {
      "description": "Respuesta de la PC a la consulta de orden de inicio del ciclo.",
      "oneOf": [
        {
          "type": "object",
          "properties": { "orden": { "enum": ["esperando", "iniciar"] } },
          "required": ["orden"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "error": { "const": "consulta_invalida" } },
          "required": ["error"],
          "additionalProperties": false
        }
      ]
    },
    "orangepi_a_pc__consulta_estado_ciclo": {
      "type": "object",
      "description": "Consulta TCP corta de la Orange Pi a la PC (puerto TCP_PUERTO_DECISION_DEFECTO) ANTES DE CADA OBJETO: ¿continuar o detener? Ver informe 4.8.",
      "properties": {
        "consulta": { "const": "estado_ciclo" }
      },
      "required": ["consulta"],
      "additionalProperties": false
    },
    "pc_a_orangepi__respuesta_estado_ciclo": {
      "description": "Respuesta de la PC a la consulta de continuar/detener el ciclo.",
      "oneOf": [
        {
          "type": "object",
          "properties": { "ciclo": { "enum": ["continuar", "detener"] } },
          "required": ["ciclo"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "error": { "const": "consulta_invalida" } },
          "required": ["error"],
          "additionalProperties": false
        }
      ]
    },
    "orangepi_a_esp32__solicitar_telemetria": {
      "type": "object",
      "description": "La Orange Pi pide la telemetría; la ESP32-S3 responde con el evento telemetria (informe 5.6).",
      "properties": {
        "accion": {
          "const": "solicitar_telemetria"
        }
      },
      "required": [
        "accion"
      ],
      "additionalProperties": false
    },
    "esp32_a_orangepi__telemetria": {
      "type": "object",
      "description": "Telemetría de la ESP32-S3 (informe 5.6). Un sensor que falló se manda como null.",
      "properties": {
        "evento": {
          "const": "telemetria"
        },
        "t_ms": {
          "type": "integer",
          "minimum": 0
        },
        "estado": {
          "enum": [
            "reposo",
            "moviendo"
          ]
        },
        "alarma": {
          "type": "boolean"
        },
        "giro_dps": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          },
          "minItems": 3,
          "maxItems": 3
        },
        "corriente_ma": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          },
          "minItems": 2,
          "maxItems": 2
        },
        "enc": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "null"
            ]
          },
          "minItems": 5,
          "maxItems": 5
        },
        "pwm": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000
          },
          "minItems": 11,
          "maxItems": 11
        },
        "uart_ok": {
          "type": "integer",
          "minimum": 0
        },
        "uart_err": {
          "type": "integer",
          "minimum": 0
        },
        "heap": {
          "type": "integer",
          "minimum": 0
        },
        "temp_c": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "evento",
        "t_ms",
        "estado",
        "alarma",
        "giro_dps",
        "corriente_ma",
        "enc",
        "pwm",
        "uart_ok",
        "uart_err",
        "heap",
        "temp_c"
      ],
      "additionalProperties": false
    },
    "orangepi_a_pc__telemetria": {
      "type": "object",
      "description": "Telemetría de la Orange Pi y la última de la ESP32-S3 (informe 4.9). Conexión corta al puerto 5001.",
      "properties": {
        "consulta": {
          "const": "telemetria"
        },
        "orange_pi": {
          "type": "object",
          "properties": {
            "t_s": {
              "type": "integer",
              "minimum": 0
            },
            "fase": {
              "enum": [
                "esperando_orden",
                "introduciendo",
                "capturando",
                "enviando",
                "esperando_regente",
                "recuperando_pc",
                "detenido"
              ]
            },
            "cpu_temp_c": {
              "type": [
                "number",
                "null"
              ]
            },
            "cpu_pct": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "ram_pct": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "disco_pct": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "wifi_dbm": {
              "type": [
                "number",
                "null"
              ]
            },
            "rtt_pc_ms": {
              "type": [
                "number",
                "null"
              ]
            },
            "camara": {
              "enum": [
                "disponible",
                "ausente"
              ]
            },
            "uart": {
              "enum": [
                "ok",
                "sin_respuesta"
              ]
            },
            "ciclos": {
              "type": "integer",
              "minimum": 0
            },
            "lotes_vacios": {
              "type": "integer",
              "minimum": 0
            },
            "ultimo_ciclo_s": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "t_s",
            "fase",
            "cpu_temp_c",
            "cpu_pct",
            "ram_pct",
            "disco_pct",
            "wifi_dbm",
            "rtt_pc_ms",
            "camara",
            "uart",
            "ciclos",
            "lotes_vacios",
            "ultimo_ciclo_s"
          ],
          "additionalProperties": false
        },
        "esp32": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "t_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "estado": {
                  "enum": [
                    "reposo",
                    "moviendo"
                  ]
                },
                "alarma": {
                  "type": "boolean"
                },
                "giro_dps": {
                  "type": "array",
                  "items": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "corriente_ma": {
                  "type": "array",
                  "items": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "enc": {
                  "type": "array",
                  "items": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "minItems": 5,
                  "maxItems": 5
                },
                "pwm": {
                  "type": "array",
                  "items": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1000
                  },
                  "minItems": 11,
                  "maxItems": 11
                },
                "uart_ok": {
                  "type": "integer",
                  "minimum": 0
                },
                "uart_err": {
                  "type": "integer",
                  "minimum": 0
                },
                "heap": {
                  "type": "integer",
                  "minimum": 0
                },
                "temp_c": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "t_ms",
                "estado",
                "alarma",
                "giro_dps",
                "corriente_ma",
                "enc",
                "pwm",
                "uart_ok",
                "uart_err",
                "heap",
                "temp_c"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "esp32_edad_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "consulta",
        "orange_pi",
        "esp32",
        "esp32_edad_s"
      ],
      "additionalProperties": false
    },
    "pc_a_orangepi__respuesta_telemetria": {
      "description": "Respuesta de la PC al mensaje de telemetría.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            }
          },
          "required": [
            "ok"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "const": "consulta_invalida"
            }
          },
          "required": [
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "pc_a_orangepi__respuesta_clasificacion": {
      "type": "object",
      "description": "Respuesta TCP de la PC tras procesar (o rechazar) el lote de imágenes.",
      "properties": {
        "clasificacion": {
          "type": "string",
          "description": "Tipo de producto identificado, o ERROR_REVISION_MANUAL si no hubo consenso o el lote llegó vacío."
        }
      },
      "required": ["clasificacion"],
      "additionalProperties": false
    }
  },
  "_pendiente_de_decision": {
    "dispensador": "Mensaje del servo del dispensador aún no definido formalmente — ver docs/arquitectura_comunicacion.md sección 5.5. No agregar aquí hasta confirmar ESP32-S3 vs. Orange Pi."
  }
}
